<Window x:Class="GUI.TrackingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LNscope — Offline tracking"
        Width="1180" Height="800" MinWidth="950" MinHeight="650" WindowStartupLocation="CenterOwner"
        Style="{StaticResource {x:Type Window}}">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Offline tracking" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Mark the pipette tip and target manually. Image coordinates only — this window cannot send motor commands."
                       Foreground="#62758B" Margin="0,6,0,12" TextWrapping="Wrap"/>
            <WrapPanel Margin="0,0,0,10">
                <Button Content="Open video" Click="OnOpen" Margin="0,0,8,0"/>
                <Button Content="Play" Click="OnPlay" Margin="0,0,8,0"/>
                <Button Content="Pause" Click="OnPause" Margin="0,0,8,0"/>
                <Button Content="Next frame" Click="OnNext" Margin="0,0,16,0"/>
                <TextBlock Text="Seek (seconds)" VerticalAlignment="Center"/>
                <TextBox x:Name="SeekSeconds" Text="0" Width="80" Margin="8,0"/>
                <Button Content="Seek / clear points" Click="OnSeek" Margin="0,0,8,0"/>
                <Button Content="Export CSV" Click="OnExport"/>
            </WrapPanel>
            <TextBlock x:Name="FileLabel" Text="Open a local recording to begin." TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
        </StackPanel>
        <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Text="No video loaded." TextWrapping="Wrap" Margin="0,10,0,0"/>
        <Border DockPanel.Dock="Right" Width="265" Style="{StaticResource Card}" Margin="12,0,0,0">
            <StackPanel>
                <TextBlock Text="1. Choose a point" FontWeight="Bold" Margin="0,0,0,8"/>
                <RadioButton x:Name="TipMode" Content="Pipette tip (cyan)" IsChecked="True" Margin="0,4"/>
                <RadioButton Content="Target (amber)" Margin="0,4"/>
                <TextBlock Text="Pause, then click the exact feature in the image. The square is the tracked patch, not a cell outline."
                           TextWrapping="Wrap" Foreground="#62758B" Margin="0,8,0,12"/>
                <Button Content="Clear both points" Click="OnReset"/>
                <Separator Margin="0,14"/>
                <TextBlock Text="2. Track and inspect" FontWeight="Bold"/>
                <TextBlock x:Name="TipInfo" Text="Tip: not selected" TextWrapping="Wrap" Margin="0,12,0,8"/>
                <TextBlock x:Name="TargetInfo" Text="Target: not selected" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <TextBlock x:Name="OffsetInfo" Text="Offset: select both points" FontFamily="Consolas" TextWrapping="Wrap"/>
                <Separator Margin="0,14"/>
                <TextBlock Text="Red = tracking lost. Playback pauses; reselect the point. Similarity is not a probability of correct identity."
                           TextWrapping="Wrap" Foreground="#62758B"/>
                <TextBlock Text="XYZ navigation needs calibration of the camera, platform and manipulator. No Z estimate is produced here."
                           TextWrapping="Wrap" Foreground="#62758B" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
        <Border Background="#111C28" CornerRadius="6" ClipToBounds="True">
            <Viewbox Stretch="Uniform">
                <Grid x:Name="Surface" Width="640" Height="480" Background="Transparent" MouseLeftButtonDown="OnMark">
                    <Image x:Name="VideoImage" Stretch="Fill"/>
                    <Canvas x:Name="Overlay" IsHitTestVisible="False"/>
                </Grid>
            </Viewbox>
        </Border>
    </DockPanel>
</Window>
