<Window x:Class="GUI.CameraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Camera" SizeToContent="WidthAndHeight" ResizeMode="CanMinimize" MinWidth="480" MinHeight="360"
        Background="#111" FontFamily="Segoe UI" FontSize="13"
        KeyDown="OnKeyDown" KeyUp="OnKeyUp" Deactivated="OnDeactivated" Focusable="True">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding Image}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="Live view" Foreground="White" FontSize="24" HorizontalAlignment="Center" />
            <TextBlock Text="Connect the camera, then start the live stream." Foreground="#A4B5C7" Margin="0,10,0,20" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Connect" Command="{Binding ConnectCommand}" Margin="0,0,8,0" />
                <Button Content="Start live" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </StackPanel>
        <Image Source="{Binding Image}"
               Width="{Binding DisplayWidth}"
               Height="{Binding DisplayHeight}"
               Stretch="Fill"
               RenderOptions.BitmapScalingMode="LowQuality" />
    </Grid>
</Window>
