<Window x:Class="GUI.CameraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:devices="clr-namespace:LnScope.Core.Devices;assembly=LnScope.Core"
        xmlns:mvvm="clr-namespace:GUI.Mvvm"
        Title="Video workspace" Width="1280" Height="880" MinWidth="820" MinHeight="540"
        Background="#101820" FontFamily="Segoe UI" FontSize="13"
        KeyDown="OnKeyDown" KeyUp="OnKeyUp" Deactivated="OnDeactivated" Focusable="True">
    <Window.Resources>
        <mvvm:NotConverter x:Key="Not" />
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DFE7EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <DataTemplate DataType="{x:Type devices:NumericProperty}">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="85" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="70" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Slider Grid.Column="1" VerticalAlignment="Center" Margin="4,0"
                        Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                        TickFrequency="{Binding Step}" IsSnapToTickEnabled="True"
                        IsEnabled="{Binding IsReadOnly, Converter={StaticResource Not}}"
                        Value="{Binding Value, Mode=TwoWay, ValidatesOnExceptions=True}" />
                <DockPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Unit}" Margin="3,0,0,0" VerticalAlignment="Center"/>
                    <TextBox TextAlignment="Right" IsEnabled="{Binding IsReadOnly, Converter={StaticResource Not}}"
                             ToolTip="Enter a value, then press Tab to apply"
                             Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
                </DockPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type devices:BooleanProperty}">
            <CheckBox Margin="0,6" Content="{Binding Name}"
                      IsChecked="{Binding Value, Mode=TwoWay, ValidatesOnExceptions=True}"
                      IsEnabled="{Binding IsReadOnly, Converter={StaticResource Not}}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type devices:ChoiceProperty}">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="85" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" Margin="4,0"
                          ItemsSource="{Binding Options}"
                          SelectedItem="{Binding Value, Mode=TwoWay}"
                          IsEnabled="{Binding IsReadOnly, Converter={StaticResource Not}}" />
            </Grid>
        </DataTemplate>


    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
        <Grid Margin="16,14,12,14">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="VIDEO WORKSPACE" Foreground="#A4B8CA" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SourceLabel" Text="Live camera" Foreground="White" FontSize="18" Margin="0,4,8,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock x:Name="ResolutionLabel" Grid.Column="1" Foreground="#A4B8CA" VerticalAlignment="Center"/>
            </Grid>
            <Border Grid.Row="1" BorderBrush="#344352" BorderThickness="1" CornerRadius="8" Background="#0B1117" ClipToBounds="True">
                <ScrollViewer x:Name="VideoViewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              SizeChanged="OnViewportSizeChanged" PreviewMouseWheel="OnVideoWheel" Padding="0">
                    <Viewbox x:Name="VideoScale" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid x:Name="ImageSurface" Width="640" Height="480" Background="#1B2733">
                            <Image x:Name="Preview" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Canvas x:Name="Overlay" Background="Transparent" MouseLeftButtonDown="OnSelect"/>
                        </Grid>
                    </Viewbox>
                </ScrollViewer>
            </Border>
            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <TextBlock x:Name="AnalysisStatus" Foreground="#B9CAD9" Text="Connect a camera and start live view, or open a test video." TextWrapping="Wrap"/>
                <TextBlock x:Name="SelectionStatus" Foreground="#D8B87A" Text="Select an object outline to follow its track." TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
        <ScrollViewer x:Name="Sidebar" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#F1F5F9" Padding="14">
            <StackPanel>
                <TextBlock Text="Camera &amp; video" FontSize="21" FontWeight="SemiBold" Foreground="#172B40" Margin="0,2,0,4"/>
                <TextBlock Text="{Binding Id}" Style="{StaticResource Hint}" Margin="0,0,0,14"/>
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="View" Style="{StaticResource Heading}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Button x:Name="ZoomOutButton" Content="−" Click="OnZoomOut" ToolTip="Zoom out"/>
                            <TextBlock x:Name="ZoomLabel" Grid.Column="1" Text="100%" MinWidth="86" TextAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas"/>
                            <Button x:Name="ZoomInButton" Grid.Column="2" Content="+" Click="OnZoomIn" ToolTip="Zoom in"/>
                        </Grid>
                        <Slider x:Name="ZoomSlider" Minimum="0.1" Maximum="4" Value="{Binding Zoom, Mode=TwoWay}" Margin="0,10" ToolTip="Display zoom: 10% to 400%"/>
                        <UniformGrid Columns="2">
                            <Button x:Name="NativeSizeButton" Content="100% · Native" Click="OnNativeSize" Margin="0,0,4,0"/>
                            <Button x:Name="FitSizeButton" Content="Fit to window" Click="OnFitSize" Margin="4,0,0,0"/>
                        </UniformGrid>
                        <TextBlock Text="Ctrl + wheel to zoom. Scroll to explore the image." Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="Analysis" Style="{StaticResource Heading}"/>
                        <UniformGrid Columns="2">
                            <ToggleButton x:Name="Segment" Content="Segment" Checked="OnAnalysisChanged" Unchecked="OnAnalysisChanged" Padding="10,7" Margin="0,0,4,0"/>
                            <ToggleButton x:Name="Track" Content="Track" Checked="OnAnalysisChanged" Unchecked="OnAnalysisChanged" Padding="10,7" Margin="4,0,0,0"/>
                        </UniformGrid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Confidence" VerticalAlignment="Center"/>
                            <Slider x:Name="Confidence" Grid.Column="1" Minimum="0.1" Maximum="0.95" Value="0.55" Margin="8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=Confidence, StringFormat=F2}" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Experimental masks and visual tracks." Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Section}">
                    <StackPanel x:Name="LiveSettings">
                        <TextBlock Text="Acquisition" Style="{StaticResource Heading}"/>
                        <TextBlock Text="{Binding State}" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
                        <UniformGrid Columns="2">
                            <Button Content="Connect" Command="{Binding ConnectCommand}" Margin="0,0,4,6"/>
                            <Button Content="Disconnect" Command="{Binding DisconnectCommand}" Margin="4,0,0,6"/>
                            <Button Content="Start live" Command="{Binding StartCommand}" Margin="0,0,4,0"/>
                            <Button Content="Stop live" Command="{Binding StopCommand}" Margin="4,0,0,0"/>
                        </UniformGrid>
                        <TextBlock Text="Sensor mode" Style="{StaticResource Hint}" Margin="0,12,0,4"/>
                        <ComboBox x:Name="SensorMode" ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}"/>
                        <Grid Margin="0,10,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Frame rate (fps)" VerticalAlignment="Center"/>
                            <TextBox x:Name="FrameRateInput" Grid.Column="1" TextAlignment="Right" KeyDown="OnFrameRateKeyDown" Text="{Binding TargetFps, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
                        </Grid>
                        <TextBlock Text="0 = automatic. Enter or Tab applies. Windows camera: restart live view to apply." Style="{StaticResource Hint}"/>
                        <TextBlock Text="{Binding MeasuredFps, StringFormat=Measured: {0:0.0} fps}" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding DroppedFrames, StringFormat=Display dropped: {0}}" Style="{StaticResource Hint}"/>
                        <Expander Header="Image adjustments" Margin="0,12,0,0">
                            <StackPanel Margin="0,8,0,0">
                                <CheckBox Content="Flip horizontal" IsChecked="{Binding FlipHorizontal}" Margin="0,4"/>
                                <CheckBox Content="Flip vertical" IsChecked="{Binding FlipVertical}" Margin="0,4"/>

                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="Recording" Style="{StaticResource Heading}"/>
                        <TextBlock Text="Output folder" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=LostFocus}" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="…" Width="34" Margin="6,0,0,0" Click="OnBrowseOutputFolder" ToolTip="Choose output folder"/>
                        </Grid>
                        <UniformGrid Columns="2" Margin="0,10,0,0">
                            <Button x:Name="RecordButton" Content="● Record" Foreground="#B33447" Command="{Binding RecordCommand}" Margin="0,0,4,0"/>
                            <Button Content="Stop recording" Command="{Binding StopRecordingCommand}" Margin="4,0,0,0"/>
                        </UniformGrid>
                        <TextBlock Text="{Binding RecordingStatus}" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                        <TextBlock Text="Video and matching coordinate log are saved together." Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <TabControl x:Name="CameraTuning" TabStripPlacement="Top" Margin="0,0,0,12"
                            Background="#F1F5F9" IsEnabled="{Binding IsEnabled, ElementName=LiveSettings}">
                    <TabItem Header="Exposure">
                        <Border Padding="8,6">
                            <StackPanel IsEnabled="{Binding IsConnected}">
                                <ItemsControl x:Name="ExposureControls" ItemsSource="{Binding ExposureProperties}"/>
                                <TextBlock Text="Connect a camera that provides exposure controls." Foreground="#64748B">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=ExposureControls}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </TabItem>
                    <TabItem Header="Color">
                        <Border Padding="8,6">
                            <StackPanel IsEnabled="{Binding IsConnected}">
                                <ItemsControl x:Name="ColorControls" ItemsSource="{Binding ColorProperties}"/>
                                <TextBlock Text="Connect a camera that provides color controls." Foreground="#64748B">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=ColorControls}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </TabItem>
                </TabControl>
                <Border Style="{StaticResource Section}">
                    <Expander Header="Test video" IsExpanded="False">
                        <StackPanel Margin="0,10,0,0">
                            <UniformGrid Columns="2">
                                <Button Content="Open video" Click="OnOpenVideo" Margin="0,0,4,6"/>
                                <Button Content="Live camera" Click="OnLive" Margin="4,0,0,6"/>
                                <Button x:Name="Play" Content="Play / pause" Click="OnPlay" IsEnabled="False" Margin="0,0,4,0"/>
                                <Button x:Name="Next" Content="Next frame" Click="OnNext" IsEnabled="False" Margin="4,0,0,0"/>
                            </UniformGrid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="SeekSeconds" Text="0" Margin="0,0,6,0"/>
                                <Button x:Name="Seek" Grid.Column="1" Content="Seek (s)" Click="OnSeek" IsEnabled="False"/>
                            </Grid>
                        </StackPanel>
                    </Expander>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
