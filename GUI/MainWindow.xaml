<Window x:Class="GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:devices="clr-namespace:LnScope.Core.Devices;assembly=LnScope.Core"
        xmlns:mvvm="clr-namespace:GUI.Mvvm"
        xmlns:behaviors="clr-namespace:GUI.Behaviors"
        Title="LNscope — Instrument control" Height="860" Width="1320" MinHeight="700" MinWidth="1180" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13" Style="{StaticResource {x:Type Window}}"
        KeyDown="OnKeyDown" KeyUp="OnKeyUp" Deactivated="OnDeactivated">

    <Window.Resources>
        <mvvm:NotConverter x:Key="Not" />

        <Style TargetType="Slider">
            <Setter Property="behaviors:WheelScroll.Enabled" Value="True" />
        </Style>

        <DataTemplate DataType="{x:Type devices:NumericProperty}">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="70" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" />
                <Slider Grid.Column="1" VerticalAlignment="Center" Margin="4,0"
                        Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                        TickFrequency="{Binding Step}" IsSnapToTickEnabled="True"
                        IsEnabled="{Binding IsReadOnly, Converter={StaticResource Not}}"
                        Value="{Binding Value, Mode=TwoWay}" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
                           FontFamily="Consolas">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0:0.##} {1}">
                            <Binding Path="Value" />
                            <Binding Path="Unit" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type devices:BooleanProperty}">
            <CheckBox Margin="0,6" Content="{Binding Name}"
                      IsChecked="{Binding Value, Mode=TwoWay}"
                      IsEnabled="{Binding IsReadOnly, Converter={StaticResource Not}}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type devices:ChoiceProperty}">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" Margin="4,0"
                          ItemsSource="{Binding Options}"
                          SelectedItem="{Binding Value, Mode=TwoWay}"
                          IsEnabled="{Binding IsReadOnly, Converter={StaticResource Not}}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AxisTemplate">
            <Border BorderBrush="#E8EDF3" BorderThickness="0,0,0,1" Padding="0,6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AtLimit}" Value="True">
                                <Setter Property="Background" Value="#FEE2E2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Id}" FontWeight="Bold" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CounterLabel}" Foreground="#62758B" FontSize="10" />
                        <TextBlock FontFamily="Consolas" FontSize="16">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0:0.000} {1}">
                                    <Binding Path="Position" />
                                    <Binding Path="Unit" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Text="{Binding ReferenceText}" Foreground="#62758B" FontSize="10" />
                        <TextBlock Text="{Binding LimitsText}" Foreground="#888" FontSize="10" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                        <Button Content="−" Width="30" Padding="0" ToolTip="Move down by the step distance" Command="{Binding StepDownCommand}" />
                        <TextBox Width="60" Margin="4,0" TextAlignment="Right"
                                 ToolTip="Relative step (axis units)" Text="{Binding Step, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                        <Button Content="+" Width="30" Padding="0" ToolTip="Move up by the step distance" Command="{Binding StepUpCommand}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBox Width="80" TextAlignment="Right"
                                 ToolTip="Target in the displayed counter. Converted to counter 1 before motion; C1 travel limits still apply." Text="{Binding Target, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                        <Button Content="Go" Margin="4,0" Padding="10,2" Command="{Binding GoCommand}" />
                        
                    </StackPanel>
                    <DockPanel Grid.Column="4" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#CCC" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMoving}" Value="True">
                                            <Setter Property="Fill" Value="#3B8BEB" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding LimitText}" Foreground="#B91C1C" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AtLimit}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PositionerTemplate">
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Id}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding State}" Foreground="#666" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Connect" Padding="10,3" Command="{Binding ConnectCommand}" />
                            <Button Content="Disconnect" Padding="10,3" Margin="6,0,0,0" Command="{Binding DisconnectCommand}" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" /><ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="150" /><ColumnDefinition Width="160" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Axis" FontSize="11" Foreground="#62758B" />
                        <TextBlock Grid.Column="1" Text="Position / limits" FontSize="11" Foreground="#62758B" />
                        <TextBlock Grid.Column="2" Text="Relative step" Margin="8,0,0,0" FontSize="11" Foreground="#62758B" />
                        <TextBlock Grid.Column="3" Text="Target (shown counter)" Margin="8,0,0,0" FontSize="11" Foreground="#62758B" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Axes}" ItemTemplate="{StaticResource AxisTemplate}"
                                  IsEnabled="{Binding IsConnected}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CameraControlsTemplate">
            <StackPanel Margin="0,0,0,14">
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="{Binding Id}" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding State}" Foreground="#666" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <Border Background="#F0F5F8" CornerRadius="3" Padding="8,6" Margin="0,0,0,8">
                    <StackPanel>
                        <StackPanel.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Consolas" />
                                <Setter Property="FontSize" Value="11" />
                            </Style>
                        </StackPanel.Resources>
                        <TextBlock Text="{Binding CurrentMode, StringFormat=mode: {0}}" />
                        <TextBlock Text="{Binding MeasuredFps, StringFormat=measured: {0:0.0} fps}" />
                        <TextBlock Text="{Binding DroppedFrames, StringFormat=display dropped: {0}}" />
                        <TextBlock Text="{Binding RecordingStatus, StringFormat=recording: {0}}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <UniformGrid Columns="2" Rows="2" Margin="0,0,0,8">
                    <Button Content="Connect" Margin="0,0,4,0" Command="{Binding ConnectCommand}" />
                    <Button Content="Disconnect" Margin="0,0,4,0" Command="{Binding DisconnectCommand}" />
                    <Button Content="Start live" Margin="0,4,4,0" Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" />
                    <Button Content="Stop live" Margin="0,4,0,0" Command="{Binding StopCommand}" />
                </UniformGrid>

                <StackPanel>
                    <TextBlock Text="Sensor mode" Foreground="#666" FontSize="11" Margin="0,4,0,2" />
                    <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" />

                    <Grid Margin="0,8,0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Window zoom" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Margin="4,0" ItemsSource="{Binding ZoomLevels}" SelectedItem="{Binding Zoom}">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat={}{0:P0}}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,6,0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Frame rate" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Margin="4,0" TextAlignment="Right" KeyDown="OnFrameRateKeyDown"
                                 ToolTip="Enter 0 for automatic FPS, or a positive value. Enter or Tab saves. Windows camera changes apply on the next Start live." Text="{Binding TargetFps, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                    </Grid>
                    <TextBlock Text="0 = automatic. Enter / Tab saves. Windows camera: Stop live → Start live to apply; actual FPS depends on the sensor mode." TextWrapping="Wrap" Foreground="#888" FontSize="11" Margin="104,0,0,6" />

                    <Separator Margin="0,8" />
                    <TextBlock Text="Image" FontWeight="Bold" Margin="0,0,0,4" />
                    <CheckBox Content="Flip horizontal" IsChecked="{Binding FlipHorizontal}" Margin="0,3" />
                    <CheckBox Content="Flip vertical" IsChecked="{Binding FlipVertical}" Margin="0,3" />
                    <ItemsControl ItemsSource="{Binding Properties}" Margin="0,6,0,0" />

                    <Separator Margin="0,8" />
                    <Expander Header="Recording settings" IsExpanded="True" Margin="0,0,0,8"><StackPanel Margin="0,8,0,0">

                    <TextBlock Text="Output folder" Foreground="#666" FontSize="11" />
                    <Grid Margin="0,2,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding OutputDirectory, UpdateSourceTrigger=LostFocus}" />
                        <Button Grid.Column="1" Content="…" Width="30" Margin="4,0,0,0" Click="OnBrowseOutputFolder" />
                    </Grid>

                    <TextBlock Text="{Binding RecordingStatus}" Foreground="#666" FontSize="11"
                               TextWrapping="Wrap" Margin="0,0,0,6" />

                    </StackPanel></Expander><UniformGrid Columns="2">
                        <Button Content="● Record" Margin="0,0,4,0" Foreground="#B33447" Command="{Binding RecordCommand}" />
                        <Button Content="Stop recording" Command="{Binding StopRecordingCommand}" />
                    </UniformGrid>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="20">
        <Border DockPanel.Dock="Top" Margin="0,0,0,18">
            <Grid>
                <StackPanel>
                    <TextBlock Text="LNscope" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="Instrument control · Motion and imaging" Foreground="#62758B" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#E5F2F3" CornerRadius="5" Padding="12,7" Margin="0,0,12,0">
                        <TextBlock Text="{Binding EnvironmentLabel}" Foreground="#087F8C" />
                    </Border>
                    <Button Content="■ Stop" Command="{Binding StopAllCommand}" Background="#B91C1C" Foreground="White" FontWeight="Bold" ToolTip="Stop all axes on the platform and manipulators" Margin="0,0,12,0" />
                    <Button Content="Hardware setup" Click="OnHardwareSetup" Margin="0,0,8,0" />
                    <Button Content="SM-10 commands" Click="OnSm10Commands" Margin="0,0,8,0" />
                    <Button Content="Save configuration" Command="{Binding SaveConfigCommand}" />
                </StackPanel>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#E8EEF5" CornerRadius="5" Padding="10,7" Margin="0,14,0,0">
            <TextBlock Text="{Binding LatestMessage}" FontSize="12" Foreground="#52667D"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding LatestMessage}" />
        </Border>
        <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="420" /></Grid.ColumnDefinitions>
        

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Positioners}" ItemTemplate="{StaticResource PositionerTemplate}" />
        </ScrollViewer>

        <TabControl Grid.Column="1" Margin="12,0,0,0">
            <TabItem Header="Camera">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>
                        <Button Content="Offline tracking · video" Margin="0,0,0,8" Click="OnOfflineTracking" />
                        <Button Content="Object map · saved observations" Margin="0,0,0,8" Click="OnObjectMap" />
                        <Button Content="Open live view" Style="{StaticResource PrimaryButton}" Margin="0,0,0,12" Click="OnOpenCameraWindow" />
                        <ItemsControl ItemsSource="{Binding Cameras}" ItemTemplate="{StaticResource CameraControlsTemplate}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Motion">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12">
            <StackPanel>
                <Grid>
                    <TextBlock Text="Motion workspace" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />

                </Grid>
                <ItemsControl ItemsSource="{Binding Links}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,6">
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Description}" Foreground="#888" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Keyboard step, um" VerticalAlignment="Center" />
                    <TextBox Width="70" Margin="8,0,0,0" TextAlignment="Right"
                             Text="{Binding JogStep, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                    <TextBlock Text="Rate" Margin="12,0,6,0" VerticalAlignment="Center" />
                    <ComboBox Width="65" ItemsSource="{Binding JogRates}" SelectedItem="{Binding JogRate}" />

                </StackPanel>
                <TextBlock Text="Hold keys · release to stop" Foreground="#888" FontSize="11" Margin="0,8,0,0" />
                <TextBlock TextWrapping="Wrap" Text="{Binding JogRateDescription}" Foreground="#62758B" FontSize="11" Margin="0,5,0,0" />
                <TextBlock Text="Red = hardware end switch or software C1 limit. Hardware numeric travel bounds are not exposed by this protocol."
                           Foreground="#62758B" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                <Separator Margin="0,12" />
                <TextBlock Text="Saved positions" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="Save stores all axes of the selected device. Go recalls that device only; motion links do not apply."
                           TextWrapping="Wrap" Foreground="#62758B" FontSize="11" Margin="0,6,0,0" />
                <ItemsControl ItemsSource="{Binding Positioners}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#DCE4EE" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,10,0,0">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Id}" FontWeight="Bold" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding State}" Foreground="#62758B" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <StackPanel IsEnabled="{Binding CanUsePositionMemory}">
                                        <ItemsControl ItemsSource="{Binding PositionSlots}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="2,0">
                                                        <TextBlock Text="{Binding Number}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                                        <Button Content="Save" Padding="6,3" Command="{Binding SaveCommand}" ToolTip="Overwrite this controller slot with current positions. Does not move." />
                                                        <Button Content="Go" Padding="6,3" Margin="0,4,0,0" Command="{Binding GoCommand}" ToolTip="Move all axes of this device to the controller slot. Use top Stop to cancel." />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="Go speed (1–15)" VerticalAlignment="Center" />
                                            <ComboBox Width="65" Margin="8,0,0,0" ItemsSource="{Binding PresetVelocities}" SelectedItem="{Binding PresetVelocity}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="{Binding MemoryStatus}" FontSize="10" Foreground="#62758B" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Stored targets cannot be read back. Go cannot precheck the destination; limits are monitored during motion. Use known slots. Group commands have no ACK."
                           TextWrapping="Wrap" FontSize="11" Foreground="#62758B" Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>

            </TabItem>
            <TabItem Header="Keyboard">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Add" Padding="12,3" Command="{Binding AddBindingCommand}" />
                        <Button Content="Apply" Padding="12,3" Margin="6,0,0,0" Click="OnApplyBindings" />
                        <Button Content="Save config" Padding="12,3" Margin="6,0,0,0" Command="{Binding SaveConfigCommand}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Bindings}" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Key" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                                 behaviors:KeyCaptureBox.Enabled="True" BorderThickness="0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Device" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.DeviceIds, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding Device, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Axis" Width="45" Binding="{Binding Axis, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTemplateColumn Header="Dir" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.Directions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding Direction, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="35">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="×" ToolTip="Remove binding" Padding="4,1" Click="OnRemoveBinding" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Journal">
                <ListBox ItemsSource="{Binding Journal}" FontFamily="Consolas" FontSize="11"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" BorderThickness="0" />
            </TabItem>
        </TabControl>
    </Grid>
    </DockPanel>
</Window>

